# Load library
library(readxl)
# Membaca dataset
superstore <- read_excel(
"C:/Users/WINDOWS 11/Downloads/Sample - Superstore (1).xls",
col_types = c("numeric", "text", "date", "numeric", "text", "text", "text", "text",
"text", "text", "text", "numeric", "text", "text", "text", "text",
"text", "numeric", "numeric", "numeric", "numeric"))
# Melihat isi dataset
View(superstore)
# Mencari tanggal satu tahun sebelum data terakhir
tahunlalu <- as.Date("2017-12-30") - 365
# Menyimpan data dalam seq tanggal selama 1 tahun lalu
tanggal <- seq(tahunlalu, as.Date("2017-12-30"), by = "day")
# Inisialisasi vektor untuk menyimpan profit harian
profit_harian <- numeric(length(tanggal))
# Loop untuk menghitung profit harian
for (i in seq_along(tanggal)) {
tgl <- tanggal[i]  # Ambil tanggal dari vektor tanggal
profit_harian[i] <- sum(superstore$Profit[superstore$`Order Date` == tgl], na.rm = TRUE)
}
# Membuat data frame hasil perhitungan
superstore_profit <- data.frame(Tanggal = tanggal, Profit = profit_harian)
# Menampilkan hasil dalam bentuk grafik batang
barplot(superstore_profit$Profit,
names.arg = format(superstore_profit$Tanggal, "%d-%m-%Y"),
las = 2,
cex.names = 0.6,
col = "steelblue",
main = "Profit Harian Superstore",
xlab = "Tanggal",
ylab = "Total Profit")
